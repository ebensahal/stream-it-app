{
  "appId": "il.bensahal.streamit",
  "appName": "STREAM IT",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*.strem.io",
      "*.strem.fun",
      "*.yts.mx",
      "*.apibay.org",
      "*.metahub.space",
      "*.tmdb.org",
      "*.vidlink.pro",
      "*.vidsrc.cc",
      "*.multiembed.mov",
      "*.webtor.io",
      "*.youtube-nocookie.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
